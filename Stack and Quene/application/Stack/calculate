#include <iostream>
#include <string>
using namespace std;
int calculate(){
    char a;
    cin>>a;
    if(a=='+'){
        return calculate()+calculate();
    }
    if(a=='-'){
        return calculate()-calculate();
    }
    if(a=='*'){
        return calculate()*calculate();
    }
    if(a=='/'){
        return calculate()/calculate();
    }
    else return (int)(a-'0');
}
int main(){
    int result=calculate();
    cout<<result<<endl;
}
