    SElemSet data_;
    Node* next_;
    Node(SElemSet a,Node* b){
        data_=a;next_=b;
    }
};
class Stack{
    private:
    int size_;
    Position top_;
    public:
    Stack(){
        size_=0;
        top_=nullptr;
    }
    Stack(const Stack& other){
        if(other.IsEmpty()){
            top_=nullptr;
            size_=0;
            return;
        }
        size_=other.size_;
        top_=new Node{other.top_->data_,nullptr};
        Position temp=other.top_;
        Position p=top_;
        while(temp->next_!=nullptr){
            p->next_=new Node{temp->next_->data_,nullptr};
            p=p->next_;
            temp=temp->next_;
        }

    }
    Stack& operator=(const Stack& other){
        if(&other==this) return *this;
        size_=other.size_;
        Position p=top_;
        while(p!=nullptr){
            Position temp=p->next_;
            delete p;
            p=temp;
        }
        if(other.IsEmpty()){
            top_=nullptr;
            return *this;
        }
        Position temp=other.top_;
        top_=new Node{other.top_->data_,nullptr};
        p=top_;
        while(temp->next_!=nullptr){
            p->next_=new Node{temp->next_->data_,nullptr};
            p=p->next_;
            temp=temp->next_;
        }
        return *this;
    }
    ~Stack(){
        if(top_==nullptr) return;
        Position p=top_;
        while(p!=nullptr){
            Position temp=p->next_;
            delete p;
            p=temp;
        }
    }
    bool IsEmpty()const{
        if(top_==nullptr) return true;
        return false;
    }
    void Push(SElemSet a){
        top_=new Node{a,top_};
        size_++;
    }
    SElemSet Top()const{
        if(top_==nullptr){
            cout<<"栈是空的"<<endl;
            return -1;
        }
        return top_->data_;
    }
    void Pop(){
        if(size_==0){cout<<"栈是空的"<<endl;return;}
        Position temp=top_->next_;
        delete top_;
        top_=temp;
        size_--;
    }
};
