#include <iostream>

using SElemSet = int;

struct Node {
    SElemSet data_;
    Node* next_;
    Node(SElemSet d, Node* n = nullptr) : data_(d), next_(n) {}
};

class Stack {
private:
    int size_;
    Node* top_;

    // 私有辅助函数：复制另一个栈的内容到当前对象（假定当前对象为空）
    void copyFrom(const Stack& other) {
        if (other.top_ == nullptr) return;
        top_ = new Node(other.top_->data_);
        Node* src = other.top_->next_;
        Node* dest = top_;
        while (src) {
            dest->next_ = new Node(src->data_);
            dest = dest->next_;
            src = src->next_;
        }
        size_ = other.size_;
    }

public:
    // 默认构造
    Stack() : size_(0), top_(nullptr) {}

    // 拷贝构造
    Stack(const Stack& other) : size_(0), top_(nullptr) {
        copyFrom(other);
    }

    // 赋值运算符（copy-and-swap）
    Stack& operator=(Stack other) {   // 传值，自动调用拷贝构造
        swap(*this, other);
        return *this;
    }

    // 析构
    ~Stack() {
        while (top_) {
            Node* temp = top_->next_;
            delete top_;
            top_ = temp;
        }
    }

    // 交换
    friend void swap(Stack& a, Stack& b) noexcept {
        using std::swap;
        swap(a.size_, b.size_);
        swap(a.top_, b.top_);
    }

    bool IsEmpty() const { return top_ == nullptr; }
    int Size() const { return size_; }

    void Push(SElemSet x) {
        top_ = new Node(x, top_);
        ++size_;
    }

    SElemSet Top() const {
        if (IsEmpty()) {
            std::cout << "栈是空的" << std::endl;
            return -1;   // 假设 -1 不是合法元素
        }
        return top_->data_;
    }

    void Pop() {
        if (IsEmpty()) {
            std::cout << "栈是空的" << std::endl;
            return;
        }
        Node* temp = top_->next_;
        delete top_;
        top_ = temp;
        --size_;
    }
};








