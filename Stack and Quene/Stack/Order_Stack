#include <iostream>
using namespace std;
using Position=int;
using SElemSet=int;
class Stack{
    private:
    int capacity_;
    SElemSet* data_;
    Position top_;
    public:
    Stack(int a){
        capacity_=a;
        data_=new SElemSet[a];
        top_=-1;
    }
    Stack(const Stack& a){
        capacity_=a.capacity_;
        data_=new SElemSet[capacity_];
        int i=0;
        for(i;i<=a.top_;i++){
            data_[i]=a.data_[i];
        }
        top_=a.top_;
    }
    Stack& operator=(const Stack& a){
        if(&a==this) return *this;
        delete data_;
        capacity_=a.capacity_;
        data_=new SElemSet[capacity_];
        int i=0;
        for(i;i<=a.top_;i++){
            data_[i]=a.data_[i];
        }
        top_=a.top_;
        return *this;
    }
    ~Stack(){
        capacity_=0;
        top_=-1;
        delete data_;
    }
    int Length()const{
        return top_+1;
    }
    bool IsFull()const{
        if(top_+1==capacity_) return true;
        return false;
    }
    bool IsEmpty()const{
        if(top_==-1) return true;
        return  false;
    }
    void Push(SElemSet x){
        if(this->IsFull()){
            cout<<"栈满了"<<endl;
            return;
        }
        data_[top_+1]=x;
        top_++;
    }
    SElemSet Top()const{
        if(this->IsEmpty()){
            cout<<"栈是空的"<<endl;
            return -1;
        }
        return data_[top_];
    }
    void Pop(){
        if(this->IsEmpty()){
            cout<<"栈是空的"<<endl;
            return;
        }
        top_--;
    }
};
