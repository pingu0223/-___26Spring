Polynomial Polynomial::derivative() {
    Polynomial result;
    node** tail = &result.head; // 指向尾指针的指针

    for (node* p = head; p != nullptr; p = p->next) {
        int new_c = p->c * p->e;
        int new_e = p->e - 1;
        if (new_c != 0) {
            *tail = new node{new_c, new_e};
            tail = &((*tail)->next);
        }
    }
    return result;
}
