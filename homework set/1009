cpp
void Polynomial::insert(int c, int e) {
    if (c == 0) return; // 系数为 0 无需插入

    node* prev = nullptr;
    node* curr = head;

    // 寻找插入位置（指数降序）
    while (curr && curr->e > e) {
        prev = curr;
        curr = curr->next;
    }

    if (curr && curr->e == e) {
        // 合并同类项
        curr->c += c;
        if (curr->c == 0) {
            // 删除该节点
            if (prev) prev->next = curr->next;
            else head = curr->next;
            delete curr;
        }
        return;
    }

    // 创建新节点并插入
    node* newNode = new node(c, e);
    if (prev == nullptr) {
        newNode->next = head;
        head = newNode;
    } else {
        newNode->next = curr;
        prev->next = newNode;
    }
}
