使用类,基本结构：
#include <iostream>
using namespace std;
class LinkedList{
    public:
     struct ListNode{
        int data_;
        ListNode* next_;
      };
      using Position=ListNode*;
      //此处应该添加无数个成员函数/友元函数————用来操作
    private:
      int length_;
      Position next_;
    }；
  创建
    LinkedList();
    LinkedList(const LinkedList& a);


  实现：
普通创建：
    LinkedList::LinkedList(){
      length_=0;
      head_=nullptr;
    }
深拷贝：
    LinkedList::LinkedList(const LinkedList& a){
      //先判断a是不是空链表
			if(a.head_==nullptr) head_=nullptr;
			else{
			Position p=a.head_;
			cout<<"a.head:"<<a.head_<<endl;
			head_=new ListNode{p->data_,nullptr};
			Position q=head_;
			cout<<"q:"<<q<<endl;
			p=p->next_;
			while(p!=nullptr){
				q->next_=new ListNode{p->data_,nullptr};
				q=q->next_;
				p=p->next_;
			}}
			length_=a.length_;
}
析构函数：
~LinkList(){
			Position p=head_;
			Position q=p;
			while(p!=nullptr){
				q=p->next_;
				delete p;
				p=q;
			}
			length_=0;
			cout<<"已成功释放内存";
		}
