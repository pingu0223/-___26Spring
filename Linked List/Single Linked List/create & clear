使用类,基本结构：
#include <iostream>
using namespace std;
class LinkedList{
    public:
     struct ListNode{
        int data_;
        ListNode* next_;
      };
      using Position=ListNode*;
      //此处应该添加无数个成员函数/友元函数————用来操作
    private:
      int length_;
      Position next_;
    }；
  创建
    LinkedList();
    LinkedList(const LinkedList& a);


  实现：
普通创建：
    LinkedList::LinkedList(){
      length_=0;
      head_=nullptr;
    }
深拷贝：
    LinkedList::LinkedList(const LinkedList& a){
      //先判断a是不是空链表
			if(a.head_==nullptr) head_=nullptr;
			else{
			Position p=a.head_;
			cout<<"a.head:"<<a.head_<<endl;
			head_=new ListNode{p->data_,nullptr};
			Position q=head_;
			cout<<"q:"<<q<<endl;
			p=p->next_;
			while(p!=nullptr){
				q->next_=new ListNode{p->data_,nullptr};
				q=q->next_;
				p=p->next_;
			}}
			length_=a.length_;
}
析构函数：
~LinkList(){
			Position p=head_;
			while(p!=nullptr){
				Position temp=p->next_;
				delete p;
				p=temp;
			}
			length_=0;
			cout<<"已成功释放内存"<<endl;
		}
友元赋值函数：
LinkList& operator=(const LinkList& a){
			if(this == &a) return *this;
			else {
				this->clear();
				//判断空链表
				if (a.head_==nullptr) {
				head_=nullptr;length_=0;}
				else{
				length_=a.length_;
				Position p=a.head_;
				head_=new ListNode{p->data_,nullptr};
				Position q=head_;
				while(p->next_!=nullptr){
					p=p->next_;
					q->next_=new ListNode{p->data_,nullptr};
					q=q->next_;
					
				}
				
		}
			}
			return *this;
			 
		}




插入：
	void insert(int i,int data){
		if(i==1){
			Position p=head_;
			head_=new ListNode{data,nullptr};
			head_->next_=p;
			length_+=1;
			return;
		}
		if(i<1||i>length_+1) return;
		Position p=head_;
		int n=0;
		for(n=0;n<i-2;n++){
			p=p->next_; 
			cout<<"p->data:"<<p->data_<<endl;
		}
		//p到达i-1位置,当i=2时直接下面的操作就行~ 
		Position temp=p->next_;
		p->next_=new ListNode{data,nullptr};
		p->next_->next_ =temp;
		length_+=1;
		return ;
		}









